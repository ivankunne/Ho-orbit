# Secrets shared by all Edge Functions in this project.
#
# 1. Copy this file to `.env` (same folder):  cp .env.example .env
# 2. Paste your real keys below.
# 3. From the ho-orbit/ folder run:  ./supabase/deploy-notify.sh
#                                and ./supabase/deploy-stripe.sh
#
# Do NOT add SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY here — the platform
# injects those automatically and rejects them as secrets.

# Your Resend API key (https://resend.com/api-keys). Starts with "re_".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL used to build links inside the emails.
SITE_URL=https://h-orbit.nl

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate once with `npx web-push generate-vapid-keys`. The PUBLIC key must
# match VITE_VAPID_PUBLIC_KEY in the frontend env. The PRIVATE key is secret —
# it lives ONLY here. VAPID_SUBJECT is a contact (mailto: or https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@h-orbit.nl

# ── Stripe (stripe-checkout, stripe-portal, stripe-webhook) ────────────────
# Use a Restricted key (rk_...) scoped to Customers/Checkout Sessions/Billing
# Portal Sessions/Subscriptions (read), not the full secret key, per Stripe's
# own security guidance. Test mode first: rk_test_... / sk_test_...
STRIPE_SECRET_KEY=rk_test_REPLACE_ME
# Price ID of the H-orbit Pro subscription (Dashboard → Product catalog).
STRIPE_PRICE_ID=price_REPLACE_ME
# Signing secret from Dashboard → Developers → Webhooks → your endpoint.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
